{
  "name": "notes-api-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Starter de la API de Notas para el practico de Testing (TUPProIV)",
  "homepage": "https://github.com/JulianRiedinger7/tp2-prograiv-2026#readme",
  "bugs": {
    "url": "https://github.com/JulianRiedinger7/tp2-prograiv-2026/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JulianRiedinger7/tp2-prograiv-2026.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:ui": "npx vitest --ui --coverage",
    "start:e2e": "cross-env NODE_ENV=test PORT=4000 ts-node src/server.ts",
    "test:e2e": "playwright test",
    "report:e2e": "playwright show-report"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.5",
    "@types/supertest": "^2.0.16",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "cross-env": "^7.0.3",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}

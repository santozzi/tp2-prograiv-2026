{
  "name": "notes-api-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Starter de la API de Notas para el practico de Testing (TUPProIV)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:ui": "npx vitest --ui --coverage",
    "start:e2e": "cross-env NODE_ENV=test PORT=4000 ts-node src/server.ts",
    "test:e2e": "playwright test",
    "report:e2e": "playwright show-report"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.19.2",
    "node": "27.0.0-alpha.0.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^2.0.16",
    "@vitest/coverage-v8": "^2.0.5",
    "@vitest/ui": "^2.1.9",
    "cross-env": "^7.0.3",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
